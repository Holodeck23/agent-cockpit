{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit Candidate",
  "version": "0.1.4",
  "identifier": "local.cockpit.webkit-candidate",
  "build": {
    "frontendDist": "starting"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
