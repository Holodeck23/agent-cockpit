{
  "name": "agent-cockpit",
  "productName": "Cockpit",
  "version": "0.1.4",
  "description": "Desktop cockpit for coding-agent CLIs (Claude Code, Codex): parallel threads, approvals, workflows.",
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "check:paths": "tsx scripts/check-public-paths.ts",
    "verify": "npm run check:paths && npm run typecheck && npm test && npm run build && npm run build:electron",
    "release": "tsx scripts/release.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts",
    "smoke:antigravity": "tsx scripts/smoke-antigravity.ts",
    "smoke:updates": "tsx scripts/smoke-updates.ts",
    "smoke:mcp": "npm run build:electron && tsx scripts/smoke-mcp.ts",
    "build:electron": "tsx scripts/build-electron.ts",
    "icon": "tsx scripts/make-icon.ts",
    "dmg-background": "tsx scripts/make-dmg-background.ts",
    "app": "npm run build && npm run build:electron && electron .",
    "package": "npm run build && npm run build:electron && electron-builder --mac --arm64",
    "proof:app": "tsx scripts/proof-app.ts",
    "proof:mcp": "tsx scripts/proof-4.ts",
    "proof:reliability": "tsx scripts/proof-reliability.ts",
    "proof:workflows": "tsx scripts/proof-workflows.ts",
    "proof:files": "tsx scripts/proof-files.ts",
    "proof:phone": "tsx scripts/proof-phone.ts",
    "proof:limit": "tsx scripts/proof-limit.ts",
    "proof:activity": "tsx scripts/proof-activity.ts",
    "proof:agents": "tsx scripts/proof-agents.ts",
    "proof:instructions": "tsx scripts/proof-instructions.ts",
    "proof:discovery": "tsx scripts/proof-discovery.ts",
    "proof:edit": "tsx scripts/proof-edit.ts",
    "proof:docs": "tsx scripts/proof-docs.ts",
    "proof:context": "tsx scripts/proof-context.ts",
    "proof:git": "tsx scripts/proof-git.ts",
    "proof:processes": "tsx scripts/proof-processes.ts",
    "proof:thread-menu": "tsx scripts/proof-thread-menu.ts",
    "proof:schedules": "tsx scripts/proof-schedules.ts",
    "proof:gallery": "tsx scripts/proof-gallery.ts",
    "proof:appearance": "tsx scripts/proof-appearance.ts",
    "proof:settings": "tsx scripts/proof-settings.ts",
    "proof:dock": "tsx scripts/proof-dock.ts",
    "proof:project-settings": "tsx scripts/proof-project-settings.ts",
    "proof:files-extras": "tsx scripts/proof-files-extras.ts",
    "proof:lifecycle": "tsx scripts/proof-lifecycle.ts",
    "proof:memory": "tsx scripts/proof-memory.ts",
    "proof:import": "tsx scripts/proof-import.ts",
    "proof:opencode": "tsx scripts/proof-opencode.ts",
    "proof:antigravity": "tsx scripts/proof-antigravity.ts",
    "proof:preview": "tsx scripts/proof-preview.ts",
    "dock-frames": "tsx scripts/make-dock-frames.ts",
    "proof:conversation-read": "tsx scripts/proof-conversation-read.ts",
    "proof:agent-controls": "tsx scripts/proof-agent-controls.ts",
    "proof:onboarding": "tsx scripts/proof-onboarding.ts",
    "proof:recovery": "tsx scripts/proof-recovery.ts",
    "proof:director": "tsx scripts/proof-director.ts",
    "proof:startup": "tsx scripts/proof-startup.ts",
    "proof:updates": "tsx scripts/proof-updates.ts",
    "proof:wave-1": "tsx scripts/proof-wave-1.ts",
    "proof:wave-2": "tsx scripts/proof-wave-2.ts",
    "proof:wave-3": "tsx scripts/proof-wave-3.ts",
    "proof:wave-4": "tsx scripts/proof-wave-4.ts",
    "package:proof": "npm run build && npm run build:electron && electron-builder --mac dir --arm64 -c.directories.output=release/proof",
    "proof:quit": "tsx scripts/proof-quit.ts"
  },
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "private": true,
  "dependencies": {
    "@milkdown/kit": "7.22.2"
  }
}
