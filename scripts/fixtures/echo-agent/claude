#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Stand-in `claude` for proofs that only need a turn to finish: every message gets a short
# reply and a successful result. Exits on stdin EOF, like the real CLI.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit echo fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"echo-fixture"}\n' "$session"
turn=0
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  printf '{"type":"assistant","message":{"id":"echo-%s","role":"assistant","content":[{"type":"text","text":"Done."}]}}\n' "$turn"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"Done.","total_cost_usd":0,"duration_ms":5}\n'
done
