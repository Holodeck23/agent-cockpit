#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Stand-in `claude` for `npm run proof:lifecycle`. Each turn answers in Cockpit's turn shape: an
# acknowledgement, a tool step, updates, then a conclusion. A message mentioning "question" ends
# with a Question:, one mentioning "blocker" ends with a Blocked:, anything else with an answer.
# Exits on stdin EOF, like the real CLI.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit lifecycle fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"lifecycle-fixture"}\n' "$session"
turn=0
say() { printf '{"type":"assistant","message":{"id":"life-%s-%s","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$turn" "$1" "$2"; sleep 0.3; }
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  say ack "On it: checking the project first."
  printf '{"type":"assistant","message":{"id":"life-%s-tool","role":"assistant","content":[{"type":"tool_use","id":"toolu_%s","name":"Read","input":{"file_path":"README.md"}}]}}\n' "$turn" "$turn"
  printf '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_%s","type":"tool_result","content":"# demo"}]}}\n' "$turn"
  sleep 0.3
  case "$line" in
    *question*) say u1 "Read the README; two deploy targets are configured."
                say end "Question: Should this go to staging or production?" ;;
    *blocker*)  say end "Blocked: The deploy key is missing from this machine." ;;
    *)          say u1 "Tests pass."
                say u2 "Build is clean.\\nWarnings: none."
                say end "Done. The page now loads in under a second." ;;
  esac
  printf '{"type":"result","subtype":"success","is_error":false,"result":"ok","total_cost_usd":0,"duration_ms":900}\n'
done
