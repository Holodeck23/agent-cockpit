#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Phase 7 stand-in: starts a local app, opens it in Cockpit, then asks the desktop shell
# for the same PNG that inspect_preview returns to a real agent (the conversation's own page).
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit preview fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"preview-fixture"}\n' "$session"
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  started=$(curl -s -X POST "$COCKPIT_MCP_URL/api/mcp/processes" \
    -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' \
    -d '{"command":"node server.js","name":"preview app"}')
  id=$(printf '%s' "$started" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
  url=""
  attempts=0
  while [ -z "$url" ] && [ "$attempts" -lt 40 ]; do
    attempts=$((attempts + 1))
    sleep 0.1
    listed=$(curl -s "$COCKPIT_MCP_URL/api/mcp/processes" -H "authorization: Bearer $COCKPIT_MCP_TOKEN")
    url=$(printf '%s' "$listed" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
  done
  opened=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$COCKPIT_MCP_URL/api/mcp/preview" \
    -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' -d "{\"url\":\"$url\"}")
  shot_response=$(curl -s -w '\n%{http_code}' -X POST "$COCKPIT_MCP_URL/api/mcp/preview/screenshot" \
    -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' -d "{\"url\":\"$url\"}")
  shot_status=$(printf '%s\n' "$shot_response" | tail -n 1)
  shot=$(printf '%s\n' "$shot_response" | sed '$d')
  meta=$(printf '%s' "$shot" | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => { try { const d = JSON.parse(s).data; process.stdout.write(`${d.mimeType} ${d.width}x${d.height}`) } catch {} })')
  # Since W9-11 the image is the conversation's own page at its viewport size, not a fixed 1280x800.
  case "$meta" in 'image/png '[1-9]*x[1-9]*) inspected=yes ;; *) inspected=no ;; esac
  text="Opened the embedded preview (HTTP $opened) and inspected its PNG: $inspected ($meta; HTTP $shot_status). Process $id."
  printf '{"type":"assistant","message":{"id":"preview-fixture","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$text"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0,"duration_ms":5}\n' "$text"
done
