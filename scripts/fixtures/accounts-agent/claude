#!/bin/sh
# Stand-in `claude` for order 16 (account profiles), no provider usage. Which account it is signed
# in to is the file .fixture-identity in its config folder ($CLAUDE_CONFIG_DIR, else ~/.claude),
# holding "<email> <used percent>". `auth login` prints a link, reads the pasted code ("ok:<email>"
# signs in as that email, anything else fails) and records $BROWSER; `auth logout` signs out (a
# .fixture-logout-fails file makes it fail). A session answers "Done as <email>" and logs each
# launch to $COCKPIT_PROOF_ACCOUNT_LOG: context, account, session/resume, whether a handoff came.
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit accounts fixture)"; exit 0; }
dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
ctx="${CLAUDE_CONFIG_DIR:-default}"
identity="$dir/.fixture-identity"
email=""; used=""
[ -f "$identity" ] && read -r email used < "$identity"
if [ "$1" = "auth" ]; then
  case "$2" in
    status)
      if [ -n "$email" ]; then printf '{"loggedIn":true,"authMethod":"claude.ai","email":"%s","orgId":"org-%s","subscriptionType":"pro"}\n' "$email" "$email"; exit 0; fi
      printf '{"loggedIn":false}\n'; exit 1 ;;
    login)
      mkdir -p "$dir"
      printf '%s\n' "${BROWSER:-unset}" > "$dir/.fixture-browser"
      echo "Opening browser to sign in…"
      echo "If the browser didn't open, visit: https://claude.com/cai/oauth/authorize?code=true&fixture=accounts&state=$$"
      printf 'Paste code here if prompted > '
      IFS= read -r code || exit 1
      case "$code" in
        ok:*) printf '%s 12\n' "${code#ok:}" > "$identity"; echo "Login successful."; exit 0 ;;
        *) echo "Login failed: that code was not accepted."; exit 1 ;;
      esac ;;
    logout)
      [ -f "$dir/.fixture-logout-fails" ] && { echo "Logout failed: keychain locked" >&2; exit 1; }
      rm -f "$identity"; echo "Successfully logged out from your Anthropic account."; exit 0 ;;
  esac
  exit 2
fi
session=""; resume="-"; prompt=""; handoff=no; previous=""
for arg in "$@"; do
  case "$previous" in
    --session-id) session="$arg" ;;
    --resume) session="$arg"; resume="$arg" ;;
    --append-system-prompt-file) prompt="$arg" ;;
    --append-system-prompt) case "$arg" in *USER:*) handoff=yes ;; esac ;;
  esac
  previous="$arg"
done
[ -n "$prompt" ] && grep -q 'USER:' "$prompt" 2>/dev/null && handoff=yes
[ -n "$COCKPIT_PROOF_ACCOUNT_LOG" ] && printf 'claude ctx=%s account=%s session=%s resume=%s handoff=%s\n' "$ctx" "${email:-none}" "$session" "$resume" "$handoff" >> "$COCKPIT_PROOF_ACCOUNT_LOG"
printf '{"type":"system","subtype":"init","session_id":"%s","model":"accounts-fixture"}\n' "$session"
if [ -z "$email" ]; then
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Not logged in · Please run /login","total_cost_usd":0,"duration_ms":1}\n'
  exit 1
fi
turn=0
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  case "$line" in *HOLD*) sleep 8 ;; esac
  printf '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","rateLimitType":"five_hour","unifiedWindows":{"five_hour":{"utilization":0.%s}}}}\n' "${used:-10}"
  printf '{"type":"assistant","message":{"id":"acct-%s","role":"assistant","content":[{"type":"text","text":"Done as %s"}]}}\n' "$turn" "$email"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"Done as %s","total_cost_usd":0,"duration_ms":5}\n' "$email"
done
