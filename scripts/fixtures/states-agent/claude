#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Stand-in `claude` for `npm run proof:states`. The first message picks the state the conversation
# is left in: "starting" reports nothing at all, "working" starts a session and never finishes,
# "question" ends asking you something, "error" ends with a failed result, anything else finishes.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit states fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
say() { printf '{"type":"assistant","message":{"id":"states-%s","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$1" "$2"; }
held=""
while IFS= read -r line; do
  case "$line" in
    *'"subtype":"interrupt"'*)
      # Stop: a held turn ends the way the real CLI reports one.
      [ -n "$held" ] && printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"stopped","total_cost_usd":0,"duration_ms":5}\n'
      held=""; continue ;;
    *'"type":"user"'*) ;;
    *) continue ;;
  esac
  case "$line" in *starting*) held=1; continue ;; esac
  printf '{"type":"system","subtype":"init","session_id":"%s","model":"states-fixture"}\n' "$session"
  case "$line" in
    *working*)  held=1 ;;
    *question*) say q "Question: Should this go to staging or production?"
                printf '{"type":"result","subtype":"success","is_error":false,"result":"ok","total_cost_usd":0,"duration_ms":5}\n' ;;
    *error*)    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"The stand-in failed on purpose.","total_cost_usd":0,"duration_ms":5}\n' ;;
    *)          say done "Done. Nothing else to do."
                printf '{"type":"result","subtype":"success","is_error":false,"result":"ok","total_cost_usd":0,"duration_ms":5}\n' ;;
  esac
done
