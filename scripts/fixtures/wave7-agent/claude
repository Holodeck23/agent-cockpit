#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Stand-in `claude` for the process part of proof:wave-7 (K1/K2). Each turn asks the cockpit MCP
# API to start "dev server" with this session's token: `node server.js`, or `node other.js` when
# the message says "other-command" (same name, different command: a conflict). It replies with
# the HTTP status, so the proof sees reuse (201) and conflict (409) as the agent did.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit wave 7 fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"wave7-fixture"}\n' "$session"
turn=0
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  command="node server.js"
  case "$line" in *other-command*) command="node other.js" ;; esac
  status=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$COCKPIT_MCP_URL/api/mcp/processes" \
    -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' \
    -d "{\"command\":\"$command\",\"name\":\"dev server\"}")
  text="Asked for the dev server (HTTP $status)."
  printf '{"type":"assistant","message":{"id":"w7-fixture-%s","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$turn" "$text"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0,"duration_ms":5}\n' "$text"
done
