#!/bin/sh
# Stand-in `claude` for `npm run proof:git`: starts a session and never finishes a turn,
# so its conversation stays Working for as long as the proof needs. Exits on stdin EOF.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit silent fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"silent-fixture"}\n' "$session"
while IFS= read -r line; do :; done
