#!/bin/sh
# Stand-in `claude` for `npm run proof:processes`. Each turn starts the project's dev server
# the way the cockpit MCP server does for a real agent: a POST to the cockpit's MCP API with
# this session's token (claude passes COCKPIT_MCP_URL/TOKEN through to its MCP servers).
# Like the real CLI it stays alive between turns and exits on stdin EOF.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit dev fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"dev-fixture"}\n' "$session"
turn=0
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  status=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$COCKPIT_MCP_URL/api/mcp/processes" \
    -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' \
    -d '{"command":"node server.js","name":"dev server"}')
  text="Started the dev server (HTTP $status)."
  printf '{"type":"assistant","message":{"id":"dev-fixture-%s","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$turn" "$text"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0,"duration_ms":5}\n' "$text"
done
