#!/bin/sh
[ "$1" = "--help" ] && { cat "$(dirname "$0")/../claude-help.txt"; exit 0; }
# Stand-in `claude` for proof:wave-9 (in-app browser). "open <url>" asks Cockpit to open that local
# page (open_preview). "links <a> <b>" replies with web links to <a> and <b>, an unsafe-scheme link
# and a file reference, so the proof can click them. Anything else gets a one-line answer.
[ "$1" = "--version" ] && { echo "0.0.0 (Cockpit wave 9 fixture)"; exit 0; }
session=""
previous=""
for arg in "$@"; do
  case "$previous" in --session-id|--resume) session="$arg" ;; esac
  previous="$arg"
done
printf '{"type":"system","subtype":"init","session_id":"%s","model":"wave9-fixture"}\n' "$session"
turn=0
say() {
  printf '{"type":"assistant","message":{"id":"w9-%s","role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$turn" "$1"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0,"duration_ms":5}\n' "$1"
}
while IFS= read -r line; do
  case "$line" in *'"type":"user"'*) ;; *) continue ;; esac
  turn=$((turn + 1))
  text=$(printf '%s' "$line" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p')
  case "$text" in
    open\ *)
      url=${text#open }
      code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$COCKPIT_MCP_URL/api/mcp/preview" \
        -H "authorization: Bearer $COCKPIT_MCP_TOKEN" -H 'content-type: application/json' -d "{\"url\":\"$url\"}")
      say "Opened $url (HTTP $code)." ;;
    links\ *)
      set -- ${text#links }
      say "Local: [the app]($1). Remote: [docs]($2). Unsafe: [launch](cockpit-proof-app://run). File: README.md:1" ;;
    *) say "OK." ;;
  esac
done
