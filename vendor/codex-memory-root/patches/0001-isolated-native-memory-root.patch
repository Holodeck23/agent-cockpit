--- /dev/null
+++ b/codex-rs/config/src/memory_root.rs
@@ -0,0 +1,120 @@
+//! Versioned native memory storage, independent of the account credential locator.
+
+use crate::types::MemoriesConfig;
+use codex_protocol::MemoryVersion;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use serde::Deserializer;
+use serde::de::Error;
+use std::path::PathBuf;
+
+pub fn base(config: &MemoriesConfig, codex_home: &AbsolutePathBuf) -> AbsolutePathBuf {
+    config.root.clone().unwrap_or_else(|| codex_home.clone())
+}
+
+pub fn for_version(
+    config: &MemoriesConfig,
+    codex_home: &AbsolutePathBuf,
+    version: MemoryVersion,
+) -> AbsolutePathBuf {
+    base(config, codex_home).join(version.directory_name())
+}
+
+pub(crate) fn deserialize_root<'de, D>(deserializer: D) -> Result<Option<AbsolutePathBuf>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    deserialize_absolute_root(deserializer, "memories.root")
+}
+
+pub(crate) fn deserialize_backfill_root<'de, D>(
+    deserializer: D,
+) -> Result<Option<AbsolutePathBuf>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    deserialize_absolute_root(deserializer, "sqlite_backfill_root")
+}
+
+fn deserialize_absolute_root<'de, D>(
+    deserializer: D,
+    field: &str,
+) -> Result<Option<AbsolutePathBuf>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    Option::<PathBuf>::deserialize(deserializer)?
+        .map(|path| {
+            if !path.is_absolute() {
+                return Err(D::Error::custom(format!(
+                    "{field} must be an explicit absolute path"
+                )));
+            }
+            AbsolutePathBuf::from_absolute_path_checked(path).map_err(D::Error::custom)
+        })
+        .transpose()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::MemoriesToml;
+    use codex_utils_absolute_path::test_support::PathExt;
+
+    #[test]
+    fn default_and_explicit_bases_preserve_both_version_namespaces() {
+        let account = tempfile::tempdir().unwrap();
+        let isolated = tempfile::tempdir().unwrap();
+        let home = account.path().abs();
+        let configured = MemoriesConfig {
+            root: Some(isolated.path().abs()),
+            dual_write: true,
+            ..Default::default()
+        };
+        for version in [MemoryVersion::V1, MemoryVersion::V2] {
+            assert_eq!(
+                for_version(&MemoriesConfig::default(), &home, version),
+                home.join(version.directory_name())
+            );
+            assert_eq!(
+                for_version(&configured, &home, version),
+                isolated.path().abs().join(version.directory_name())
+            );
+        }
+        assert_eq!(configured.version, MemoryVersion::V1);
+        assert!(configured.dual_write);
+        assert!(!isolated.path().join("memories").exists());
+        assert!(!account.path().join("memories").exists());
+    }
+
+    #[test]
+    fn w13_backfill_root_requires_explicit_absolute_path() {
+        use crate::config_toml::ConfigToml;
+        let dir = tempfile::tempdir().unwrap();
+        let _guard = codex_utils_absolute_path::AbsolutePathBufGuard::new(dir.path());
+        for path in ["relative", "../other", "~/history", ""] {
+            assert!(
+                toml::from_str::<ConfigToml>(&format!("sqlite_backfill_root = {path:?}")).is_err()
+            );
+        }
+        let parsed: ConfigToml = toml::from_str(&format!(
+            "sqlite_backfill_root = {:?}",
+            dir.path().display().to_string()
+        ))
+        .unwrap();
+        assert_eq!(parsed.sqlite_backfill_root, Some(dir.path().abs()));
+        assert_eq!(ConfigToml::default().sqlite_backfill_root, None);
+    }
+
+    #[test]
+    fn rejects_relative_or_home_expanded_root_even_with_a_deserialization_base() {
+        let dir = tempfile::tempdir().unwrap();
+        let _guard = codex_utils_absolute_path::AbsolutePathBufGuard::new(dir.path());
+        for path in ["relative", "../other", "~/memory", ""] {
+            assert!(toml::from_str::<MemoriesToml>(&format!("root = {path:?}")).is_err());
+        }
+        let parsed: MemoriesToml =
+            toml::from_str(&format!("root = {:?}", dir.path().display().to_string())).unwrap();
+        assert_eq!(MemoriesConfig::from(parsed).root, Some(dir.path().abs()));
+    }
+}
