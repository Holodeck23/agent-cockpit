+#[cfg(test)]
+mod isolated_root_tests {
+    use super::*;
+    use codex_extension_api::NoopTurnItemEmitter;
+    use codex_extension_api::ToolCall;
+    use codex_extension_api::ToolCallSource;
+    use codex_extension_api::ToolName;
+    use codex_extension_api::ToolPayload;
+    use codex_utils_output_truncation::TruncationPolicy;
+
+    #[tokio::test]
+    async fn w13_memory_root_native_note_write_stays_in_initial_namespace_after_config_change() {
+        let account = tempfile::tempdir().unwrap();
+        let cwd = tempfile::tempdir().unwrap();
+        let first = tempfile::tempdir().unwrap();
+        let second = tempfile::tempdir().unwrap();
+        let mut config = codex_core::config::ConfigBuilder::default()
+            .codex_home(account.path().to_path_buf())
+            .fallback_cwd(Some(cwd.path().to_path_buf()))
+            .build()
+            .await
+            .unwrap();
+        config
+            .features
+            .enable(Feature::MemoryTool)
+            .expect("enable fixture memory feature");
+        config.memories.dedicated_tools = true;
+        config.memories.use_memories = true;
+        config.memories.root = Some(AbsolutePathBuf::from_absolute_path(first.path()).unwrap());
+        let extension = MemoriesExtension::default();
+        let session = ExtensionData::new("session");
+        for version in [MemoryVersion::V1, MemoryVersion::V2] {
+            config.memories.version = version;
+            let thread = ExtensionData::new("thread");
+            thread.insert(MemoriesExtensionConfig::from_config(&config));
+            let mut changed = config.clone();
+            changed.memories.root =
+                Some(AbsolutePathBuf::from_absolute_path(second.path()).unwrap());
+            changed.memories.version = if version == MemoryVersion::V1 {
+                MemoryVersion::V2
+            } else {
+                MemoryVersion::V1
+            };
+            extension.on_config_changed(&session, &thread, &config, &changed);
+            let tool_name = ToolName::namespaced(
+                crate::MEMORY_TOOLS_NAMESPACE,
+                crate::ADD_AD_HOC_NOTE_TOOL_NAME,
+            );
+            let tool = extension
+                .tools(&session, &thread)
+                .into_iter()
+                .find(|tool| tool.tool_name() == tool_name)
+                .unwrap();
+            let payload = ToolPayload::Function { arguments: serde_json::json!({
+                "filename": "2026-10-19T00-00-00-isolated-root.md", "note": "isolated note sentinel"
+            }).to_string() };
+            tool.handle(ToolCall {
+                turn_id: "turn-1".to_string(),
+                call_id: "call-1".to_string(),
+                tool_name,
+                model: "gpt-test".to_string(),
+                codex_turn_metadata: None,
+                truncation_policy: TruncationPolicy::Bytes(1024),
+                source: ToolCallSource::Direct,
+                conversation_history: codex_extension_api::ConversationHistory::default(),
+                turn_item_emitter: Arc::new(NoopTurnItemEmitter),
+                environments: Vec::new(),
+                payload,
+            })
+            .await
+            .unwrap();
+            assert_eq!(
+                tokio::fs::read_to_string(
+                    first
+                        .path()
+                        .join(version.directory_name())
+                        .join("extensions/ad_hoc/notes/2026-10-19T00-00-00-isolated-root.md")
+                )
+                .await
+                .unwrap(),
+                "isolated note sentinel"
+            );
+            assert!(!account.path().join(version.directory_name()).exists());
+            assert!(!second.path().join(version.directory_name()).exists());
+            // Revocation still applies even though the original namespace is retained.
+            changed.memories.use_memories = false;
+            extension.on_config_changed(&session, &thread, &config, &changed);
+            assert!(extension.tools(&session, &thread).is_empty());
+        }
+    }
+}
