+#[tokio::test]
+async fn w13_memory_root_consolidation_config_binds_only_isolated_version() {
+    let account = TempDir::new().unwrap();
+    let cwd = TempDir::new().unwrap();
+    let isolated = TempDir::new().unwrap();
+    let mut config = codex_core::config::ConfigBuilder::default()
+        .codex_home(account.path().to_path_buf())
+        .fallback_cwd(Some(cwd.path().to_path_buf()))
+        .build()
+        .await
+        .unwrap();
+    config.memories.root = Some(
+        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(isolated.path()).unwrap(),
+    );
+    let provider = create_model_provider(config.model_provider.clone(), None);
+    for version in [
+        codex_protocol::MemoryVersion::V1,
+        codex_protocol::MemoryVersion::V2,
+    ] {
+        config.memories.version = version;
+        let worker = agent::get_config(
+            &config,
+            config.permissions.effective_permission_profile(),
+            provider.as_ref(),
+        )
+        .unwrap();
+        let expected = config
+            .memories
+            .root
+            .as_ref()
+            .unwrap()
+            .join(version.directory_name());
+        assert_eq!(worker.cwd, expected);
+        assert_eq!(worker.workspace_roots, vec![expected]);
+        assert_eq!(worker.codex_home, config.codex_home);
+        assert!(!worker.memories.generate_memories);
+        assert!(!worker.memories.use_memories);
+        assert!(worker.ephemeral);
+    }
+    // Constructing the worker config is not spawning it, and creates no memory artifacts.
+    assert!(!isolated.path().join("memories").exists());
+    assert!(!isolated.path().join("memories_v2").exists());
+}
